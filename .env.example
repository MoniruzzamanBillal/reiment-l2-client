# Used by `docker-compose.yml` to build/run each environment's container.
# Copy to `.env` and fill in real values. Never commit the real `.env`.
#
# All of these are Next.js NEXT_PUBLIC_* values, which get baked into the
# client JS bundle at BUILD time (not read at container runtime) — so
# rebuilding the image is required whenever one of these changes.

# ---- local ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# ---- qa ----
QA_API_URL=
QA_PUSHER_KEY=
QA_PUSHER_CLUSTER=

# ---- production ----
PROD_API_URL=
PROD_PUSHER_KEY=
PROD_PUSHER_CLUSTER=
